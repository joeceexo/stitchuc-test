# Stitch Network Test settings. Only DATABASE_URL is required to start.

# Its own Postgres database (tables are created on first start)
DATABASE_URL=postgres://postgres:password@project_postgres:5432/nettest?sslmode=disable

# Where the site lives (used in support links and emails)
NETTEST_PUBLIC_URL=https://test.stitchuc.com

# Stitch regions to time, as id=host. The first is the main one.
NETTEST_REGIONS=us-east=lk-001.us-east.ogb1.stitchuc.net,sa-east=lk-001.sa-east.scl1.stitchuc.net,apac=lk-001.apac.sgp1.stitchuc.net

# The test call. Without these three the call is skipped and results say so.
# They serve LIVEKIT_REGION (the first region if unset). Other regions can have their own:
# LIVEKIT_SA_EAST_URL, LIVEKIT_SA_EAST_API_KEY, LIVEKIT_SA_EAST_API_SECRET, and so on.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#LIVEKIT_REGION=us-east

# Stitch addresses a customer must reach (comma separated)
NETTEST_REACH=https://login.stitchuc.com

# Two STUN servers turn on the router (NAT) check, e.g. stun:host-a:3478,stun:host-b:3478
#NETTEST_STUN=

# The UDP port range shown in the firewall list for IT people, e.g. 50000-60000
#NETTEST_IT_MEDIA_UDP=

# Staff view at /staff. Set both; without the secret, staff are signed out on every restart.
NETTEST_STAFF_PASSWORD=
NETTEST_SESSION_SECRET=

# "Email me a copy" (Resend). Leave the key empty to hide the button.
RESEND_API_KEY=
MAIL_FROM=StitchUC <support@stitchuc.com>

# Limits
NETTEST_MAX_MBPS=200        # speed test ceiling
NETTEST_PER_IP_HOUR=12      # tests one address may start in an hour
NETTEST_AT_ONCE=4           # speed tests running together; others wait a few seconds
NETTEST_KEEP_DAYS=90        # how long results are kept
#NETTEST_PASS_MARKS={"lossGood":0.5,"lossFair":2}   # override any pass mark (see server/src/score.ts)

# Behind EasyPanel's proxy this is 1 (one hop). 0 when nothing is in front.
NETTEST_TRUST_PROXY=1

# Provider and place names from DB-IP's free databases, downloaded into NETTEST_GEO_DIR
#NETTEST_GEO=true
#NETTEST_GEO_DIR=/data/geo

# A label beside the name, e.g. Staging
#STITCH_BADGE=
